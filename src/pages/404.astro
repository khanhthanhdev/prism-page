---
const oldBase = "/prism-page";
const newBase = "https://prism-benchmark.github.io";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to PRISM Benchmark...</title>
    <link rel="canonical" href={newBase + "/"} />
    <meta http-equiv="refresh" content={`0; url=${newBase}/`} />
    <meta name="robots" content="noindex" />
  </head>

  <body>
    <p>
      PRISM Benchmark has moved to
      <a href={newBase + "/"}>{newBase}/</a>.
    </p>

    <script define:vars={{ oldBase, newBase }}>
      const path = location.pathname.startsWith(oldBase)
        ? location.pathname.slice(oldBase.length) || "/"
        : "/";

      location.replace(newBase + path + location.search + location.hash);
    </script>
  </body>
</html>
